#!/bin/sh
#
# Copyright (c) 2022 Amlogic, Inc. All rights reserved.
# Description: S39 wifi file (hardened: avoid unloading dhd.ko / SDIO power-down race on restart)
#

MULTI_WIFI=/usr/bin/multi_wifi_load_driver

start_wpa_suplicant() {
    start-stop-daemon -S -m -p /var/run/wpa_supplicant.pid -b -x /usr/sbin/wpa_supplicant -- -Dnl80211 -iwlan0 -c/etc/wpa_supplicant.conf >/dev/null 2>&1 </dev/null
}

stop_wpa_suplicant() {
    start-stop-daemon -K -o -p /var/run/wpa_supplicant.pid 2>/dev/null || true
    killall -q wpa_supplicant 2>/dev/null || true
    rm -rf /var/run/wpa_supplicant.pid
}

stop_network_services() {
    /etc/init.d/S80dnsmasq stop 2>/dev/null || true
    stop_wpa_suplicant
    killall -q hostapd 2>/dev/null || true
}

wifi_start() {
    stop_network_services

    echo "start wifi station mode load driver and setup......"
    if [ ! -d /sys/class/net/wlan0 ]; then
        $MULTI_WIFI station 1
        sleep 1
    fi
    mkdir -p /data/vendor/wifi
    ifconfig wlan0 up > /dev/null 2>&1
    ifconfig wlan0 > /dev/null 2>&1
    if ! ip -o -4 addr show dev wlan0 scope global 2>/dev/null | grep -q "inet "; then
        ifconfig wlan0 0.0.0.0 2>/dev/null
    fi

    if [ -d /sys/class/net/wlan0 ]; then
        echo station > /tmp/wifi_mode
        start_wpa_suplicant
        iw dev wlan0 set power_save off 2>/dev/null || true
        if [ ! -d /sys/class/net/wlan1 ]; then
            iw wlan0 interface add wlan1 type managed 2>/dev/null || true
        fi
        ifconfig wlan1 down 2>/dev/null || true
    fi
}

case "$1" in
    start)
        wifi_start
        ;;
    stop)
        stop_network_services
        ifconfig wlan1 down 2>/dev/null || true
        ifconfig wlan0 down 2>/dev/null || true
        # Do NOT call "$MULTI_WIFI station 0" on stop/restart:
        # multi_wifi_load_driver station 1 only waits 10ms after SDIO power-up,
        # whereas meson-gx-mmc SDIO re-enumeration takes ~240ms, causing
        # multi_wifi_load_driver to fall through to USB search and call
        # ioctl(0x6d04) SDIO_POWER_DOWN permanently.
        # ifconfig wlan0 down -> up already triggers dhd_stop/dhd_open firmware reload.
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit $?
