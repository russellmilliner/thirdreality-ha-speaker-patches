#!/bin/sh
#
# S99ha-speaker: unified init script and service monitor for HA speaker.
#
# Manages:
#   - netmonitor       (WiFi/internet connectivity state machine)
#   - voice-assistant  (/usr/bin/linux-voice-assistant-cpp, includes the
#                       Sendspin music player)
#   - pulseaudio       (reboot device if it dies)
#
# Usage:
#   S99ha-speaker start|stop|restart
#   S99ha-speaker <service> start|stop|restart
#
# Services: netmonitor, voice-assistant

PIDDIR=/var/run/thirdreality
MONITOR_PIDFILE=$PIDDIR/ha-speaker.pid
NETMONITOR_PIDFILE=$PIDDIR/netmonitor.pid
VOICE_PIDFILE=$PIDDIR/voice-assistant.pid
DEVICE_CONF="/data/conf/device.json"

export XDG_CONFIG_HOME=/var
export XDG_RUNTIME_DIR=/run
[ -f /tmp/dbus/dbus-addr ] && export $(cat /tmp/dbus/dbus-addr)
[ -f /tmp/dbus/dbus-pid ] && export $(cat /tmp/dbus/dbus-pid)
trap '' HUP

CHECK_INTERVAL=10

# Disable flag files: when present, the monitor loop skips restarting that service.
# Created by:  S99ha-speaker <service> stop
# Removed by:  S99ha-speaker <service> start
DISABLE_NETMONITOR=/tmp/ha_disable_netmonitor
DISABLE_VOICE=/tmp/ha_disable_voice

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

is_running() {
    local pidfile="$1"
    [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null
}

is_voice_port_listening() {
    netstat -tlne 2>/dev/null | grep -q ":6053 "
}

# ---------------------------------------------------------------------------
# netmonitor
# ---------------------------------------------------------------------------

start_netmonitor() {
    is_running "$NETMONITOR_PIDFILE" && return 0
    rm -f "$NETMONITOR_PIDFILE" "$DISABLE_NETMONITOR"
    nohup /usr/share/thirdreality/script/netmonitor >/dev/null 2>&1 </dev/null &
    echo $! > "$NETMONITOR_PIDFILE"
}

stop_netmonitor() {
    touch "$DISABLE_NETMONITOR"
    if is_running "$NETMONITOR_PIDFILE"; then
        kill "$(cat "$NETMONITOR_PIDFILE")" 2>/dev/null
    fi
    rm -f "$NETMONITOR_PIDFILE"
}

# ---------------------------------------------------------------------------
# voice-assistant
# ---------------------------------------------------------------------------

start_voice_assistant() {
    is_running "$VOICE_PIDFILE" && return 0
    rm -f "$VOICE_PIDFILE" "$DISABLE_VOICE"

    # Restart avahi so it picks up the new hostname and sendspin.service.
    /etc/init.d/S50avahi-daemon stop 2>/dev/null
    /etc/init.d/S50avahi-daemon start 2>/dev/null

    local spk_name
    spk_name=$(jq -r '.device.name // "thirdreality-speaker"' "$DEVICE_CONF")
    nohup /usr/bin/linux-voice-assistant-cpp \
        --name "$spk_name" \
        --port 6053 >/dev/null 2>&1 </dev/null &
    echo $! > "$VOICE_PIDFILE"
}

stop_voice_assistant() {
    touch "$DISABLE_VOICE"
    if is_running "$VOICE_PIDFILE"; then
        kill "$(cat "$VOICE_PIDFILE")" 2>/dev/null
        sleep 1
        kill -9 "$(cat "$VOICE_PIDFILE")" 2>/dev/null
    fi
    rm -f "$VOICE_PIDFILE"
}

# ---------------------------------------------------------------------------
# Monitor loop
# ---------------------------------------------------------------------------

monitor_loop() {
    local voice_port_fail_count=0
    while true; do
        # 1. netmonitor
        if [ ! -f "$DISABLE_NETMONITOR" ] && ! is_running "$NETMONITOR_PIDFILE"; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] netmonitor not running, restarting..."
            start_netmonitor
        fi

        # Guard against boot race with ntpdate.sh: if ntpd is already running,
        # ntpdate.sh has finished, so clear any stale boot DISABLE_VOICE lock.
        if [ -f "$DISABLE_VOICE" ] && [ ! -f /tmp/ha_manual_stop_voice ] && pidof ntpd > /dev/null 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] ntpd active; clearing boot DISABLE_VOICE lock..."
            rm -f "$DISABLE_VOICE"
        fi

        # 2. voice-assistant
        if [ ! -f "$DISABLE_VOICE" ]; then
            if ! is_running "$VOICE_PIDFILE"; then
                echo "[$(date '+%Y-%m-%d %H:%M:%S')] voice-assistant not running, restarting..."
                voice_port_fail_count=0
                start_voice_assistant
            elif is_voice_port_listening; then
                voice_port_fail_count=0
            else
                voice_port_fail_count=$((voice_port_fail_count + 1))
                if [ $voice_port_fail_count -ge 3 ]; then
                    echo "[$(date '+%Y-%m-%d %H:%M:%S')] voice-assistant port 6053 not listening for 30s, restarting..."
                    stop_voice_assistant
                    rm -f "$DISABLE_VOICE"
                    sleep 1
                    start_voice_assistant
                    voice_port_fail_count=0
                fi
            fi
        fi

        # 3. pulseaudio
        if ! pidof pulseaudio > /dev/null 2>&1; then
            echo "[$(date '+%Y-%m-%d %H:%M:%S')] pulseaudio died, rebooting..."
            sync
            sleep 3
            reboot -f
        fi

        sleep $CHECK_INTERVAL
    done
}

# ---------------------------------------------------------------------------
# Daemon lifecycle
# ---------------------------------------------------------------------------

start() {
    mkdir -p "$PIDDIR" /var/lib/ntp

    if is_running "$MONITOR_PIDFILE"; then
        echo "ha-speaker already running (PID: $(cat "$MONITOR_PIDFILE"))"
        exit 0
    fi

    # Persist machine-id and prune orphaned PulseAudio files from prior boots
    if [ -s /var/lib/dbus/machine-id ]; then
        MID="$(cat /var/lib/dbus/machine-id)"
        [ ! -s /etc/machine-id ] && cp /var/lib/dbus/machine-id /etc/machine-id
        for f in /var/pulse/*; do
            [ -e "$f" ] || continue
            case "$f" in
                *"$MID"*|*/cookie) ;;
                *) rm -f "$f" /data/overlay/upper"$f" 2>/dev/null || true ;;
            esac
        done
    fi

    /usr/share/thirdreality/script/setup_env.sh

    NETWORK_STATUS=$(jq -r '.network.status // "disconnected"' "$DEVICE_CONF" 2>/dev/null)
    if [ "$NETWORK_STATUS" = "disconnected" ]; then
        /etc/init.d/S44bluetooth up
        paplay /usr/share/thirdreality/audio/setup_mode.wav &
    fi

    rm -f /tmp/ha_manual_stop_voice
    # voice-assistant requires network (NTP sync). Disable it at boot only if
    # ntpdate.sh hasn't already completed and started ntpd.
    if ! pidof ntpd > /dev/null 2>&1 && ! is_running "$VOICE_PIDFILE"; then
        touch "$DISABLE_VOICE"
    else
        rm -f "$DISABLE_VOICE"
    fi

    start_netmonitor

    trap '' HUP
    monitor_loop >/dev/null 2>&1 </dev/null &
    echo $! > "$MONITOR_PIDFILE"
    echo "ha-speaker started (PID: $(cat "$MONITOR_PIDFILE"))"
}

stop() {
    if is_running "$MONITOR_PIDFILE"; then
        kill "$(cat "$MONITOR_PIDFILE")" 2>/dev/null
        echo "ha-speaker stopped (PID: $(cat "$MONITOR_PIDFILE"))"
    else
        echo "ha-speaker not running"
    fi
    rm -f "$MONITOR_PIDFILE"

    /etc/init.d/S44bluetooth stop
    stop_voice_assistant
    stop_netmonitor
    # Clear disable flags so next start brings everything up
    rm -f "$DISABLE_NETMONITOR" "$DISABLE_VOICE" /tmp/ha_manual_stop_voice
}

restart() {
    stop
    sleep 1
    start
}

# ---------------------------------------------------------------------------
# Per-service subcommands:  S99ha-speaker <service> start|stop|restart
# ---------------------------------------------------------------------------

service_cmd() {
    local svc="$1"
    local action="$2"
    case "$svc" in
        netmonitor)
            case "$action" in
                start)   start_netmonitor ;;
                stop)    stop_netmonitor ;;
                restart) stop_netmonitor; sleep 1; start_netmonitor ;;
                *) echo "Usage: $0 netmonitor {start|stop|restart}"; exit 1 ;;
            esac
            ;;
        voice-assistant)
            case "$action" in
                start)   rm -f /tmp/ha_manual_stop_voice; start_voice_assistant ;;
                stop)    touch /tmp/ha_manual_stop_voice; stop_voice_assistant ;;
                restart) rm -f /tmp/ha_manual_stop_voice; stop_voice_assistant; sleep 1; start_voice_assistant ;;
                *) echo "Usage: $0 voice-assistant {start|stop|restart}"; exit 1 ;;
            esac
            ;;
        *)
            echo "Unknown service: $svc"
            echo "Services: netmonitor, voice-assistant"
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

case "$1" in
    start)   start   ;;
    stop)    stop    ;;
    restart) restart ;;
    netmonitor|voice-assistant)
        service_cmd "$1" "$2"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        echo "       $0 {netmonitor|voice-assistant} {start|stop|restart}"
        exit 1
        ;;
esac
